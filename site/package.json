{
  "name": "@holocron/docs",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:api": "tsc --noEmit --strict --skipLibCheck --target ES2023 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions api/secrets.ts",
    "validate": "bun run check && bun run check:api && bun run build && node scripts/validate-site.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/markdown-satteri": "0.4.2",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@types/node": "24.19.1",
    "astro": "7.3.5",
    "typescript": "5.9.3",
    "zuedocs": "0.1.26"
  },
  "dependencies": {
    "@upstash/redis": "1.39.0"
  }
}
